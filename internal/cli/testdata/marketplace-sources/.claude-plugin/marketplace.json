{
  "name": "archive-and-command",
  "version": "1.0.0",
  "owner": {
    "name": "Donald Gifford",
    "email": "donald@example.com"
  },
  "plugins": [
    {
      "name": "archive-plugin",
      "source": {
        "source": "archive",
        "url": "https://downloads.example.com/archive-plugin-1.4.0.tar.gz",
        "sha256": "3b1f2c4d5e6a7b8c9d0e1f2a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e"
      }
    },
    {
      "name": "archive-unpinned",
      "source": {
        "source": "archive",
        "url": "https://downloads.example.com/nightly.zip"
      }
    },
    {
      "name": "command-plugin",
      "source": {
        "source": "command",
        "command": "internal-plugin-resolver --name command-plugin",
        "timeout": 30000,
        "mode": "json"
      }
    },
    {
      "name": "command-quoted-timeout",
      "source": {
        "source": "command",
        "command": "resolve-plugin",
        "timeout": "5000"
      }
    }
  ]
}
